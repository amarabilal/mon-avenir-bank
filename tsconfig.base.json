{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "isolatedModules": true,
    "paths": {
      "@monavenir/domain": ["packages/domain/src/index.ts"],
      "@monavenir/application": ["packages/application/src/index.ts"],
      "@monavenir/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@monavenir/interface-http-fastify": [
        "packages/interface-http-fastify/src"
      ]
    }
  },
  "exclude": ["node_modules", "dist"]
}
